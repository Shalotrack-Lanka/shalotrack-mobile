<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:name=".ShaloTrackApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LetsTrackLanka">

        <activity
            android:name=".ui.main.AlertsActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.main.CirclesActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.main.TagsActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.vehicles.VehiclesActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity android:name=".ui.vehicles.VehicleListActivity" android:exported="false" />

        <activity android:name=".ui.history.TripHistoryActivity" android:exported="false" />
        <activity android:name=".ui.history.TripDetailActivity" android:exported="false" />

        <activity android:name=".ui.main.reports.AlertReportActivity" android:exported="false" />
        <activity android:name=".ui.main.reports.StopReportActivity" android:exported="false" />
        <activity android:name=".ui.main.reports.KmReportActivity" android:exported="false" />

        <activity android:name=".ui.contacts.EmergencyContactsActivity" android:exported="false" />

        <activity android:name=".ui.complaints.MyComplaintsActivity" android:exported="false" />
        <activity android:name=".ui.complaints.FileComplaintActivity" android:exported="false" />
        <activity android:name=".ui.complaints.ComplaintDetailActivity" android:exported="false" />
        <activity android:name=".ui.renewals.RenewalActivity" android:exported="false" />

        <activity android:name=".ui.main.SettingsActivity" android:exported="false" />

        <!-- Account deletion (Google Play: in-app deletion path) and the "keep my account" screen -->
        <activity android:name=".ui.account.AccountDeletionActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.AddVehicleActivity" android:exported="false" />

        <activity android:name=".ui.places.PlacesActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.ValueActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.VehicleSharingActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.SharedVehicleMapActivity" android:exported="false" />

        <activity
            android:name=".ui.main.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.auth.ProcessingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.EmailInputActivity"
            android:launchMode="singleTask"
            android:exported="false" />

        <activity
            android:name=".ui.main.WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.auth.SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.auth.OtpVerificationActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <!-- Decides where a signed-in phone goes: app (existing customer) or registration (new) -->
        <activity
            android:name=".ui.auth.RouteAfterLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <!-- Launcher + verified App Link for email verification -->
        <activity
            android:name=".ui.main.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ShaloTrack.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Link for Email Verification -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="auth.shalotrack.com" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <service
            android:name=".services.ShaloTrackFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <!-- Restrict BOTH keys in Google Cloud Console: Android package + SHA-1 (upload AND Play App Signing certs) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCCEcm2yd65eBw5aUJI0akiXkwySTBS_LE" />

        <meta-data android:name="com.example.letstracklanka.STATIC_MAPS_API_KEY"
            android:value="AIzaSyAAk1aVIma-49jfCJ40SDU-8fzufCGmQnA"/>
    </application>

</manifest>