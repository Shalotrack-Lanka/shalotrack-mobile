<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Background Tracking Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ShaloTrackApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LetsTrackLanka">

        <activity
            android:name=".ui.main.AlertsActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.main.CirclesActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.main.TagsActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.vehicles.VehiclesActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity android:name=".ui.vehicles.VehicleListActivity" android:exported="false" />

        <activity android:name=".ui.history.TripHistoryActivity" android:exported="false" />
        <activity android:name=".ui.history.TripDetailActivity" android:exported="false" />

        <activity android:name=".ui.contacts.EmergencyContactsActivity" android:exported="false" />

        <activity android:name=".ui.main.SettingsActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.AddVehicleActivity" android:exported="false" />

        <activity android:name=".ui.places.PlacesActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.ValueActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.VehicleSharingActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.SharedVehicleMapActivity" android:exported="false" />

        <activity
            android:name=".ui.main.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.auth.ProcessingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.EmailInputActivity"
            android:launchMode="singleTask"
            android:exported="false" />

        <activity
            android:name=".ui.main.WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.auth.SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.auth.OtpVerificationActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <!-- ============================================================ -->
        <!-- THE LAUNCHER LIVES HERE. Updated to use SplashScreen Theme  -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.main.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ShaloTrack.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Link for Email Verification -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="auth.shalotrack.com" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- Existing Firebase Messaging Service -->
        <service
            android:name=".services.ShaloTrackFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Background Real-time Tracking Service -->
        <service
            android:name=".services.TrackingForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCCEcm2yd65eBw5aUJI0akiXkwySTBS_LE" />

        <meta-data android:name="com.example.letstracklanka.STATIC_MAPS_API_KEY"
            android:value="AIzaSyAAk1aVIma-49jfCJ40SDU-8fzufCGmQnA"/>
    </application>

</manifest>