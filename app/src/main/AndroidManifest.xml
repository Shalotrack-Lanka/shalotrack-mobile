<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:name=".ShaloTrackApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LetsTrackLanka">

        <!-- The five tabs (Map, Vehicles, Trips, Alerts, More) and the screens they open all use the app
             theme (Daylight design system). No per-screen MaterialComponents overrides any more. -->
        <!-- singleTop: a tapped alert notification reloads an Alerts screen already on top. -->
        <activity
            android:name=".ui.main.AlertsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity android:name=".ui.main.MoreActivity" android:exported="false" />

        <activity android:name=".ui.geofences.GeofencesActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.VehiclesActivity" android:exported="false" />

        <!-- Link or unlink trackers. Existed in code but was never registered, so it could not open. -->
        <activity android:name=".ui.devices.DevicesActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.VehicleListActivity" android:exported="false" />

        <activity android:name=".ui.history.TripHistoryActivity" android:exported="false" />
        <activity android:name=".ui.history.TripDetailActivity" android:exported="false" />

        <activity android:name=".ui.main.reports.AlertReportActivity" android:exported="false" />
        <activity android:name=".ui.main.reports.StopReportActivity" android:exported="false" />
        <activity android:name=".ui.main.reports.KmReportActivity" android:exported="false" />

        <activity android:name=".ui.contacts.EmergencyContactsActivity" android:exported="false" />

        <activity android:name=".ui.complaints.MyComplaintsActivity" android:exported="false" />
        <activity android:name=".ui.complaints.FileComplaintActivity" android:exported="false" />
        <activity android:name=".ui.complaints.ComplaintDetailActivity" android:exported="false" />
        <activity android:name=".ui.renewals.RenewalActivity" android:exported="false" />

        <activity android:name=".ui.main.SettingsActivity" android:exported="false" />

        <!-- Account deletion (Google Play: in-app deletion path) and the "keep my account" screen -->
        <activity android:name=".ui.account.AccountDeletionActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.AddVehicleActivity" android:exported="false" />

        <activity android:name=".ui.places.PlacesActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.ValueActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.VehicleSharingActivity" android:exported="false" />

        <activity android:name=".ui.vehicles.SharedVehicleMapActivity" android:exported="false" />

        <activity android:name=".ui.main.HomeActivity" android:exported="false" />

        <activity
            android:name=".ui.auth.ProcessingActivity"
            android:exported="false"
            android:theme="@style/Theme.ShaloTrack.Auth" />

        <activity
            android:name=".ui.auth.LinkPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ShaloTrack.Auth" />

        <activity
            android:name=".ui.auth.EmailLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ShaloTrack.Auth" />

        <activity
            android:name=".ui.places.FrequentPlacesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.stats.StatsCompareActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.EmailInputActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ShaloTrack.Auth"
            android:exported="false" />

        <activity
            android:name=".ui.main.WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.ShaloTrack.Auth" />

        <activity
            android:name=".ui.auth.OtpVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ShaloTrack.Auth" />

        <!-- Decides where a signed-in phone goes: app (existing customer) or registration (new) -->
        <activity
            android:name=".ui.auth.RouteAfterLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.ShaloTrack.Auth" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ShaloTrack.Auth" />

        <!-- Launcher only. The old https://auth.shalotrack.com App Link (email verification) was removed with
             email verification: an unused deep link is attack surface with no benefit. -->
        <activity
            android:name=".ui.main.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ShaloTrack.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <service
            android:name=".services.ShaloTrackFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <!-- Pushes that arrive while the app is in the background are drawn by the system with these. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/st_navy" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="shalotrack_alerts" />

        <!-- Maps SDK key. In Google Cloud Console it must be restricted to Android apps (package
             com.shalotrack.shalotrack + the SHA-1 of the upload key AND the Play App Signing key) and to the
             Maps SDK for Android only. The Static Maps key that used to sit here is no longer used by the app
             (trip thumbnails are lite-mode maps); delete that key in the console after this release. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCCEcm2yd65eBw5aUJI0akiXkwySTBS_LE" />
    </application>

</manifest>