<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom bar holding the reply field: white with a hairline along the top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/st_line" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_surface" />
        </shape>
    </item>
</layer-list>
