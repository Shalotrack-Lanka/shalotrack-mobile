<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline between rows in a grouped card, starting under the row text (not under the icon). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="64dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/st_line_soft" />
        <size android:height="1dp" />
    </shape>
</inset>
