<?xml version="1.0" encoding="utf-8"?>
<!-- A tap-to-choose field (vehicle) drawn like the outlined text fields: grey outline, navy when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_surface" />
            <stroke android:width="1.5dp" android:color="@color/st_navy" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/st_surface" />
            <stroke android:width="1dp" android:color="@color/st_text_4" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
