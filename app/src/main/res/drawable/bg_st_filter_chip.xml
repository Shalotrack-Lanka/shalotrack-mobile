<?xml version="1.0" encoding="utf-8"?>
<!-- Filter chip: navy fill when selected, white with line otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_navy" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/st_surface" />
            <stroke android:width="1dp" android:color="@color/st_line" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
