<?xml version="1.0" encoding="utf-8"?>
<!-- 44dp square button floating over the map: white, line border, ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1F021F4A">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/st_surface" />
            <stroke android:width="1dp" android:color="@color/st_line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
