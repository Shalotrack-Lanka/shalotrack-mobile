<?xml version="1.0" encoding="utf-8"?>
<!-- Choice card (plan picker): grey hairline at rest, 2dp navy outline when chosen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/st_surface" />
            <stroke android:width="2dp" android:color="@color/st_navy" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/st_surface" />
            <stroke android:width="1dp" android:color="@color/st_line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
