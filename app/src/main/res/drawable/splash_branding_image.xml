<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen branding image — shown at the bottom of the splash on API 31+.
    Uses windowSplashScreenBrandingImage in Theme.ShaloTrack.Starting.

    This is a layer-list wrapping logo_full.png (the full ShaloTrack lockup
    with wordmark, 612×408 RGBA transparent PNG).

    Sizing note: The SplashScreen API renders the branding image at 200dp wide
    (system-controlled). The layer-list allows us to pad it so the logo doesn't
    hit the navigation bar edge.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/logo_full"
        android:gravity="center"
        android:width="200dp"
        android:height="67dp" />
</layer-list>