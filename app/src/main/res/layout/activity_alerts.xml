<?xml version="1.0" encoding="utf-8"?>
<!-- Alerts tab: newest first, grouped by day, filter by vehicle and by kind. Tap an alert to mark it read. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/alertsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_gutter"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/st_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackAlerts"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/st_action_back"
                android:src="@drawable/ic_st_back"
                android:visibility="gone"
                app:tint="@color/st_navy" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/st_nav_alerts"
                android:textAppearance="@style/TextAppearance.ST.Display" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkAllRead"
                style="@style/Widget.ST.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/st_alerts_mark_all_read"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Which vehicle, then which kind. The vehicle chip is filled navy when one vehicle is chosen. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"
            android:clipToPadding="false"
            android:paddingStart="@dimen/st_gutter"
            android:paddingEnd="@dimen/st_gutter"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAlertsVehicle"
                    style="@style/Widget.ST.FilterChip"
                    android:layout_width="wrap_content"
                    android:drawableEnd="@drawable/ic_st_chevron_down_16"
                    android:drawableTint="@color/st_filter_chip_text"
                    android:ellipsize="end"
                    android:maxWidth="180dp"
                    android:paddingEnd="10dp"
                    android:text="@string/st_picker_all_vehicles" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/st_line"
                    android:importantForAccessibility="no" />

                <TextView android:id="@+id/chipAlertsAll" style="@style/Widget.ST.FilterChip" android:layout_width="wrap_content" android:text="@string/st_alerts_filter_all" />
                <TextView android:id="@+id/chipAlertsSpeed" style="@style/Widget.ST.FilterChip" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:text="@string/st_alerts_filter_speed" />
                <TextView android:id="@+id/chipAlertsPower" style="@style/Widget.ST.FilterChip" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:text="@string/st_alerts_filter_power" />
                <TextView android:id="@+id/chipAlertsGeofence" style="@style/Widget.ST.FilterChip" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:text="@string/st_alerts_filter_geofence" />
                <TextView android:id="@+id/chipAlertsIgnition" style="@style/Widget.ST.FilterChip" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:text="@string/st_alerts_filter_ignition" />
                <TextView android:id="@+id/chipAlertsSos" style="@style/Widget.ST.FilterChip" android:layout_width="wrap_content" android:layout_marginStart="8dp" android:text="@string/st_alerts_filter_sos" />
            </LinearLayout>
        </HorizontalScrollView>

        <include
            layout="@layout/include_inline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshAlerts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAlerts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/st_gutter"
                android:paddingEnd="@dimen/st_gutter"
                android:paddingBottom="@dimen/st_space_6" />

            <ProgressBar
                android:id="@+id/progressAlerts"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="32dp"
                android:indeterminateTint="@color/st_navy"
                android:visibility="gone" />

            <include
                layout="@layout/include_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/st_gutter"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/st_gutter" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
