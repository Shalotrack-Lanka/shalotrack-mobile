<?xml version="1.0" encoding="utf-8"?>
<!-- One complaint: its category, state and vehicle, then the conversation (the customer's words on the
     right, the dealer's and ShaloTrack's on the left) and a reply field. Closed complaints say so instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/complaintDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_canvas"
    android:orientation="vertical">

    <include layout="@layout/include_st_top_bar" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeComplaintDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvComplaintThread"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/st_gutter"
            android:paddingTop="@dimen/st_gutter"
            android:paddingEnd="@dimen/st_gutter"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_complaint_reply" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressComplaintDetail"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:indeterminateTint="@color/st_navy"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/complaintFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_st_composer_bar"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <include
            layout="@layout/include_inline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvReplyClosedNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/st_complaint_closed_notice"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutReplyComposer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <EditText
                android:id="@+id/etReplyMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_st_composer"
                android:hint="@string/st_complaint_write_reply"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="1000"
                android:maxLines="5"
                android:minHeight="44dp"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:textAppearance="@style/TextAppearance.ST.Body"
                android:textColorHint="@color/st_text_3" />

            <ImageButton
                android:id="@+id/btnSendReply"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_st_send"
                android:contentDescription="@string/st_complaint_send_reply"
                android:src="@drawable/ic_st_send"
                app:tint="@color/st_navy" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
