<?xml version="1.0" encoding="utf-8"?>
<!-- New complaint: which vehicle (own vehicles only), what it is about, what happened. Who sees it first
     is said before sending. Errors on the field or in the banner. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_canvas"
    android:orientation="vertical">

    <include layout="@layout/include_st_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/st_gutter">

            <include
                layout="@layout/include_st_vehicle_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:text="@string/st_complaint_about"
                android:textAppearance="@style/TextAppearance.ST.BodyStrong" />

            <!-- One choice; a ChipGroup only lays them out in rows. Selection is kept by FileComplaintActivity. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <TextView
                    android:id="@+id/chipCatDevice"
                    style="@style/Widget.ST.FilterChip"
                    android:layout_width="wrap_content"
                    android:text="@string/st_complaint_cat_device" />

                <TextView
                    android:id="@+id/chipCatBilling"
                    style="@style/Widget.ST.FilterChip"
                    android:layout_width="wrap_content"
                    android:text="@string/st_complaint_cat_billing" />

                <TextView
                    android:id="@+id/chipCatApp"
                    style="@style/Widget.ST.FilterChip"
                    android:layout_width="wrap_content"
                    android:text="@string/st_complaint_cat_app" />

                <TextView
                    android:id="@+id/chipCatOther"
                    style="@style/Widget.ST.FilterChip"
                    android:layout_width="wrap_content"
                    android:text="@string/st_complaint_cat_other" />

            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilComplaintDescription"
                style="@style/Widget.ST.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/st_complaint_describe"
                app:counterEnabled="true"
                app:counterMaxLength="1000"
                app:helperText="@string/st_complaint_describe_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etComplaintDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="1000"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_st_banner_info"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_st_info"
                    app:tint="@color/st_tone_info_text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/st_complaint_route_note"
                    android:textAppearance="@style/TextAppearance.ST.BodySmall"
                    android:textColor="@color/st_tone_info_text" />
            </LinearLayout>

            <include
                layout="@layout/include_inline_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/fileComplaintFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/st_canvas"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/st_gutter"
        android:paddingBottom="@dimen/st_gutter">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitComplaint"
            style="@style/Widget.ST.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/st_complaint_send" />
    </LinearLayout>
</LinearLayout>
