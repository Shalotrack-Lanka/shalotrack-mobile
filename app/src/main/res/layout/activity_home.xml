<?xml version="1.0" encoding="utf-8"?>
<!--
  REDESIGN NOTES (read before dropping in):
  - Every original android:id is kept EXACTLY the same, so your Kotlin/Java
    click-listeners, ViewBinding, and RecyclerView adapter code keep working
    with zero changes.
  - No feature was removed. Same buttons, same menu, same nav items, same
    error banner. Only spacing, shape, color grouping and hierarchy polish.
  - Three new drawables are used and included alongside this file:
      res/drawable/scrim_top_gradient.xml
      res/drawable/bg_nav_pill_active.xml
      res/drawable/bg_retry_chip.xml
    Drop all three into your res/drawable folder.
  - Key visual changes:
      1) fabLayers + fabLocation are now merged into one floating "pill"
         toolbar card instead of two separate loose FABs.
      2) A soft gradient scrim sits behind the top status-bar area for
         legibility over bright map tiles.
      3) The map-type picker cards got bigger radius + ripple feedback.
      4) The bottom action bar (Send Location / SOS / Refresh) got
         consistent radius, a bolder SOS with icon, and better spacing.
      5) "Add a Person / Vehicle / Pet / Tag / Place" rows now have
         color-coded icon chips, a trailing chevron, and ripple feedback.
      6) Bottom nav switched from a top indicator bar to a soft rounded
         "pill" highlight behind the active icon+label (Material 3 style).
      7) Error banner got a circular icon badge and a pill-shaped retry chip.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F6FA">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomNavBar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <fragment
                    android:id="@+id/map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- soft scrim so the layers/location pill and status bar
                     read cleanly no matter what's underneath on the map -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/scrim_top_gradient"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Merged "pill" toolbar: layers + location as one
                     floating card instead of two separate FABs -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="44dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="10dp"
                        app:cardBackgroundColor="@color/surface_white">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="4dp"
                            android:gravity="center_horizontal">

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/fabLayers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:backgroundTint="@android:color/transparent"
                                app:elevation="0dp"
                                app:pressedTranslationZ="0dp"
                                app:fabSize="mini"
                                app:tint="@null"
                                app:rippleColor="#14000000"
                                app:srcCompat="@drawable/ic_layers" />

                            <View
                                android:layout_width="28dp"
                                android:layout_height="1dp"
                                android:layout_marginVertical="2dp"
                                android:background="#EDEDED" />

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/fabLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:backgroundTint="@android:color/transparent"
                                app:elevation="0dp"
                                app:pressedTranslationZ="0dp"
                                app:fabSize="mini"
                                app:tint="@null"
                                app:rippleColor="#14000000"
                                app:srcCompat="@drawable/ic_my_location" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/mapTypeMenu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="10dp">

                        <GridLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:padding="12dp"
                            android:rowCount="2"
                            android:background="@color/surface_white">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardDefault"
                                android:layout_width="120dp"
                                android:layout_height="100dp"
                                android:layout_margin="6dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:rippleColor="@color/brand_primary"
                                app:strokeColor="@color/brand_primary"
                                app:strokeWidth="3dp">

                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface_white">
                                    <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/map_default" android:scaleType="centerCrop"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Default" android:textSize="15sp" android:textStyle="bold" android:textColor="#555555" android:layout_gravity="center" android:paddingVertical="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardTerrain"
                                android:layout_width="120dp"
                                android:layout_height="100dp"
                                android:layout_margin="6dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:rippleColor="@color/brand_primary"
                                app:strokeWidth="0dp">

                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface_white">
                                    <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/map_terrain" android:scaleType="centerCrop"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Terrain" android:textSize="15sp" android:textStyle="bold" android:textColor="#555555" android:layout_gravity="center" android:paddingVertical="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardSatellite"
                                android:layout_width="120dp"
                                android:layout_height="100dp"
                                android:layout_margin="6dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:rippleColor="@color/brand_primary"
                                app:strokeWidth="0dp">

                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface_white">
                                    <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/map_satellite" android:scaleType="centerCrop"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Satellite" android:textSize="15sp" android:textStyle="bold" android:textColor="#555555" android:layout_gravity="center" android:paddingVertical="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardHybrid"
                                android:layout_width="120dp"
                                android:layout_height="100dp"
                                android:layout_margin="6dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:rippleColor="@color/brand_primary"
                                app:strokeWidth="0dp">

                                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface_white">
                                    <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@drawable/map_hybrid" android:scaleType="centerCrop"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hybrid" android:textSize="15sp" android:textStyle="bold" android:textColor="#555555" android:layout_gravity="center" android:paddingVertical="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </GridLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="145dp"
                    android:layout_marginHorizontal="12dp"
                    app:cardBackgroundColor="@color/surface_white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="10dp"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendLocation"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="8dp"
                            android:text="Send Location"
                            android:textAllCaps="false"
                            android:textColor="@color/brand_primary"
                            android:textSize="15sp"
                            app:backgroundTint="@color/surface_white"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_my_location"
                            app:iconTint="@color/brand_primary"
                            app:layout_constraintHorizontal_weight="1.2"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btnSOS"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeColor="@color/brand_primary"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSOS"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="8dp"
                            android:text="SOS"
                            android:textAllCaps="false"
                            android:textColor="@color/surface_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02"
                            app:backgroundTint="@color/status_danger"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_alert"
                            app:iconTint="@color/surface_white"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:layout_constraintHorizontal_weight="0.9"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/fabRefresh"
                            app:layout_constraintStart_toEndOf="@+id/btnSendLocation"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/fabRefresh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:backgroundTint="@color/surface_background"
                            app:elevation="2dp"
                            app:fabSize="normal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_refresh"
                            app:tint="@color/brand_primary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/bottomSheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bottom_sheet_bg"
                app:behavior_hideable="false"
                app:behavior_peekHeight="130dp"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
                android:elevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#D1D5DB" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerHomeVehicles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:nestedScrollingEnabled="false" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <LinearLayout
                        android:id="@+id/btnAddPerson"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#5B8DEF"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                app:tint="@color/surface_white"
                                android:src="@android:drawable/ic_menu_call" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Add a Person"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:layout_marginStart="16dp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="#BDBDBD"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnAddVehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="@color/brand_primary"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                app:tint="@color/surface_white"
                                android:src="@drawable/ic_car" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Add a Vehicle"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:layout_marginStart="16dp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="#BDBDBD"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnAddPet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#F5A623"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                app:tint="@color/surface_white"
                                android:src="@android:drawable/ic_menu_add" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Add a Pet"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:layout_marginStart="16dp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="#BDBDBD"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnAddTag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#9B59B6"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                app:tint="@color/surface_white"
                                android:src="@drawable/ic_tag" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Add a TAG"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:layout_marginStart="16dp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="#BDBDBD"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnAddPlace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#1ABC9C"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                app:tint="@color/surface_white"
                                android:src="@android:drawable/ic_menu_myplaces" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Add a place"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:layout_marginStart="16dp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="20sp"
                            android:textColor="#BDBDBD"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- Bottom nav: floating rounded card, active item shown with a
             soft pill highlight behind icon+label instead of a top bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="@color/surface_white"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <FrameLayout
                    android:id="@+id/nav_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:alpha="0.14"
                        android:background="@drawable/bg_nav_pill_active" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_home" app:tint="@color/brand_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textSize="11sp" android:textColor="@color/brand_primary" android:textStyle="bold" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/nav_vehicles"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_car" app:tint="#9AA0A6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vehicles" android:textSize="11sp" android:textColor="#9AA0A6" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/nav_tags"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tag" app:tint="#9AA0A6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tags" android:textSize="11sp" android:textColor="#9AA0A6" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/nav_circles"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_radar" app:tint="#9AA0A6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Circles" android:textSize="11sp" android:textColor="#9AA0A6" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/nav_alerts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_alert" app:tint="#9AA0A6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alerts" android:textSize="11sp" android:textColor="#9AA0A6" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/nav_menu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_menu" app:tint="#9AA0A6"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Menu" android:textSize="11sp" android:textColor="#9AA0A6" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Error banner: circular icon badge + pill-shaped retry chip -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/errorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/status_danger"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:cardCornerRadius="15dp"
                    app:cardBackgroundColor="#22FFFFFF"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/stat_notify_error"
                        app:tint="@color/surface_white" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvErrorBannerMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Couldn't load data"
                    android:textColor="@color/surface_white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvErrorBannerRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RETRY"
                    android:textColor="@color/status_danger"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/bg_retry_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <include layout="@layout/layout_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>