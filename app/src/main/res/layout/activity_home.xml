<?xml version="1.0" encoding="utf-8"?>
<!-- Map tab (Home). Full-bleed live map, fleet summary and layers on top, the selected vehicle in a
     bottom sheet, the shared bottom bar. Design system: Daylight (design_system.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_canvas"
    android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/homeCoordinator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top: fleet summary and map layers. Pushed below the status bar by EdgeToEdge.marginTop(). -->
        <LinearLayout
            android:id="@+id/homeTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/st_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/st_gutter"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/homeSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/st_icon_button"
                    android:background="@drawable/bg_st_icon_button"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/tvFleetCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/archivo_extrabold"
                        android:textColor="@color/st_navy"
                        android:textSize="15sp"
                        tools:text="3 vehicles" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@color/st_line" />

                    <TextView
                        android:id="@+id/tvCountMoving"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/st_status_moving_text"
                        android:textSize="12sp"
                        tools:text="1" />

                    <TextView
                        android:id="@+id/tvCountStopped"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:drawablePadding="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/st_status_parked_text"
                        android:textSize="12sp"
                        tools:text="1" />

                    <TextView
                        android:id="@+id/tvCountOffline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:drawablePadding="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/st_status_offline_text"
                        android:textSize="12sp"
                        tools:text="1" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnLayers"
                    style="@style/Widget.ST.IconButton"
                    android:contentDescription="@string/st_map_layers"
                    android:src="@drawable/ic_st_layers" />
            </LinearLayout>

            <!-- Map type picker, opened by the layers button -->
            <LinearLayout
                android:id="@+id/mapTypePanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_st_card"
                android:elevation="4dp"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/mapTypeNormal"
                    style="@style/Widget.ST.MapTypeOption">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_default" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/st_map_type_default"
                        android:textAppearance="@style/TextAppearance.ST.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mapTypeSatellite"
                    style="@style/Widget.ST.MapTypeOption">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_satellite" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/st_map_type_satellite"
                        android:textAppearance="@style/TextAppearance.ST.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mapTypeTerrain"
                    style="@style/Widget.ST.MapTypeOption">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_terrain" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/st_map_type_terrain"
                        android:textAppearance="@style/TextAppearance.ST.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mapTypeHybrid"
                    style="@style/Widget.ST.MapTypeOption">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_hybrid" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/st_map_type_hybrid"
                        android:textAppearance="@style/TextAppearance.ST.Caption" />
                </LinearLayout>
            </LinearLayout>

            <include
                layout="@layout/include_inline_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Re-centre on the selected VEHICLE (never the phone's own location). Rides on the sheet's top edge. -->
        <ImageButton
            android:id="@+id/btnRecenter"
            style="@style/Widget.ST.IconButton"
            android:layout_marginEnd="@dimen/st_gutter"
            android:contentDescription="@string/st_map_recenter"
            android:src="@drawable/ic_st_target"
            android:translationY="-12dp"
            app:layout_anchor="@id/homeSheet"
            app:layout_anchorGravity="top|end"
            android:layout_gravity="top|start" />

        <!-- Selected vehicle. Peek shows plate, status, speed, place and the three actions. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_st_sheet"
            android:elevation="8dp"
            android:fillViewport="false"
            app:behavior_hideable="false"
            app:behavior_peekHeight="292dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/st_gutter"
                android:paddingTop="10dp"
                android:paddingEnd="@dimen/st_gutter"
                android:paddingBottom="@dimen/st_space_6">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_st_handle"
                    android:importantForAccessibility="no" />

                <!-- Selected vehicle -->
                <LinearLayout
                    android:id="@+id/selectedVehicleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSelPlate"
                            style="@style/Widget.ST.Plate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="WP CAB-1234" />

                        <TextView
                            android:id="@+id/tvSelModel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.ST.BodySmall"
                            tools:text="Toyota Aqua" />

                        <TextView
                            android:id="@+id/tvSelStatus"
                            style="@style/Widget.ST.StatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Moving" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSelSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textAppearance="@style/TextAppearance.ST.Number"
                            tools:text="42" />

                        <TextView
                            android:id="@+id/tvSelSpeedUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/st_unit_kmh"
                            android:textAppearance="@style/TextAppearance.ST.Label"
                            android:textColor="@color/st_text_3" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSelAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                                tools:text="Kandy Road, Kadawatha" />

                            <TextView
                                android:id="@+id/tvSelUpdated"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.ST.Caption"
                                tools:text="Updated 12 s ago" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tracker facts (same rules as the Fleet health card) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFactIgnition"
                            style="@style/Widget.ST.FactTile"
                            android:drawableStart="@drawable/ic_st_power_16"
                            tools:text="Ignition on" />

                        <TextView
                            android:id="@+id/tvFactBattery"
                            style="@style/Widget.ST.FactTile"
                            android:layout_marginStart="8dp"
                            android:drawableStart="@drawable/ic_st_battery_16"
                            tools:text="Battery 86%" />

                        <TextView
                            android:id="@+id/tvFactSignal"
                            style="@style/Widget.ST.FactTile"
                            android:layout_marginStart="8dp"
                            android:drawableStart="@drawable/ic_st_signal_16"
                            tools:text="Signal good" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShareLocation"
                            style="@style/Widget.ST.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:minHeight="48dp"
                            android:text="@string/st_home_share_location"
                            app:icon="@drawable/ic_st_share"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTrips"
                            style="@style/Widget.ST.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="@string/st_nav_trips" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSos"
                            style="@style/Widget.ST.Button.Danger"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:contentDescription="@string/st_home_sos_description"
                            android:fontFamily="@font/archivo_extrabold"
                            android:minHeight="48dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/st_home_sos" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVehicleDetails"
                        style="@style/Widget.ST.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/st_home_vehicle_details"
                        app:icon="@drawable/ic_st_chevron_right"
                        app:iconGravity="end"
                        app:iconSize="18dp" />
                </LinearLayout>

                <!-- No vehicles yet -->
                <include
                    layout="@layout/include_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <!-- Other vehicles: tap to switch the map to that vehicle -->
                <TextView
                    android:id="@+id/tvOtherVehiclesLabel"
                    style="@style/Widget.ST.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/st_home_other_vehicles" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerHomeVehicles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_st_card"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
