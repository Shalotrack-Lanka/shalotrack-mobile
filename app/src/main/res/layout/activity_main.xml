<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background">

    <!--
        Lottie animation — file and playback are set programmatically in
        MainActivity.java based on device time:
          06:00–18:59  →  shalotrack_drive_day.json   (sun, clouds, daylight)
          19:00–05:59  →  shalotrack_drive_night.json  (stars, city glow, headlights)
        Do NOT set lottie_fileName or lottie_autoPlay here — they are overridden in code.
    -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieCarAnimation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/logo_content_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:lottie_loop="true"
        app:lottie_speed="1.0" />

    <!-- ShaloTrack logo — centred in upper third, fades in at 300ms -->
    <ImageView
        android:id="@+id/mainLogo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_logo_simple"
        android:scaleType="fitCenter"
        android:alpha="0"
        android:elevation="4dp"
        android:contentDescription="@string/logo_content_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.30" />

    <!-- Loading message — fades in at 600ms -->
    <TextView
        android:id="@+id/tvLoadingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:alpha="0"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.04"
        android:text="@string/connecting_to_vehicles"
        android:textColor="#99FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/progressLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Orange progress line — grows left→right from 800ms -->
    <View
        android:id="@+id/progressLine"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginBottom="24dp"
        android:alpha="0"
        android:background="@color/brand_accent"
        android:scaleX="0"
        android:transformPivotX="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>