<?xml version="1.0" encoding="utf-8"?>
<!-- More tab: the account, then every real feature that is not a tab, grouped. Rows are built in
     MoreActivity from one list, so every row looks and behaves the same. No "coming soon" items. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_canvas"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/moreScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/moreContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/st_gutter"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/st_gutter"
            android:paddingBottom="@dimen/st_space_6">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/st_nav_more"
                android:textAppearance="@style/TextAppearance.ST.Display" />

            <include
                layout="@layout/include_inline_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- Account -->
            <LinearLayout
                android:id="@+id/profileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_st_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_st_avatar"
                    android:fontFamily="@font/archivo_bold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/st_text_on_navy"
                    android:textSize="19sp"
                    tools:text="NP" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ST.Title"
                        tools:text="Nuwan Perera" />

                    <TextView
                        android:id="@+id/tvProfilePhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.ST.BodySmall"
                        tools:text="+94 77 123 4567" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ST.BodySmall"
                        android:visibility="gone"
                        tools:text="nuwan@example.lk"
                        tools:visibility="visible" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    style="@style/Widget.ST.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/st_action_edit" />
            </LinearLayout>

            <!-- Sections are added here by MoreActivity -->
            <LinearLayout
                android:id="@+id/moreSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFeatureSettings="tnum"
                android:gravity="center_horizontal"
                android:textAppearance="@style/TextAppearance.ST.Caption"
                tools:text="ShaloTrack 2.4.0" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
