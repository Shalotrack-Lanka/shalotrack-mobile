<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Checking the account -->
    <LinearLayout
        android:id="@+id/groupRouteLoading"
        style="@style/Widget.ShaloTrack.GlassPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="32dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/glass_focus"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/route_signing_in"
            android:textColor="@color/glass_text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Inline error with Retry and Sign out (no Toast / Snackbar / dialog) -->
    <LinearLayout
        android:id="@+id/groupRouteError"
        style="@style/Widget.ShaloTrack.GlassPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvRouteError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@color/glass_text_primary"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRouteRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/route_try_again" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRouteSignOut"
            style="@style/Widget.ShaloTrack.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/route_sign_out" />
    </LinearLayout>

</FrameLayout>
