<?xml version="1.0" encoding="utf-8"?>
<!-- Trips tab: one vehicle's trips for a chosen day or week. Fixed header (vehicle, range, totals),
     the trip list scrolls under it so the route thumbnails recycle properly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tripsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_gutter"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/st_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackHistory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/st_action_back"
                android:src="@drawable/ic_st_back"
                android:visibility="gone"
                app:tint="@color/st_navy" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/st_nav_trips"
                android:textAppearance="@style/TextAppearance.ST.Display" />

            <LinearLayout
                android:id="@+id/btnTripVehicle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_st_icon_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvTripVehiclePlate"
                    style="@style/Widget.ST.Plate.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="WP CAB-1234" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_st_chevron_down"
                    app:tint="@color/st_navy" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rangeSegments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_st_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/segToday"
                style="@style/Widget.ST.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/st_time_today" />

            <TextView
                android:id="@+id/segYesterday"
                style="@style/Widget.ST.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/st_time_yesterday" />

            <TextView
                android:id="@+id/seg7Days"
                style="@style/Widget.ST.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/st_trips_7_days" />

            <TextView
                android:id="@+id/segPickDate"
                style="@style/Widget.ST.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/st_trips_pick_date" />
        </LinearLayout>

        <!-- Totals for the chosen range -->
        <LinearLayout
            android:id="@+id/tripTotals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_st_card"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout style="@style/Widget.ST.TotalCell">
                <TextView android:id="@+id/tvSumDistance" style="@style/Widget.ST.TotalValue" tools:text="48.6" />
                <TextView style="@style/Widget.ST.TotalLabel" android:text="@string/st_unit_km" />
            </LinearLayout>

            <View style="@style/Widget.ST.TotalDivider" />

            <LinearLayout style="@style/Widget.ST.TotalCell">
                <TextView android:id="@+id/tvSumDriving" style="@style/Widget.ST.TotalValue" tools:text="1:42" />
                <TextView style="@style/Widget.ST.TotalLabel" android:text="@string/st_trips_driving" />
            </LinearLayout>

            <View style="@style/Widget.ST.TotalDivider" />

            <LinearLayout style="@style/Widget.ST.TotalCell">
                <TextView android:id="@+id/tvSumTrips" style="@style/Widget.ST.TotalValue" tools:text="3" />
                <TextView style="@style/Widget.ST.TotalLabel" android:text="@string/st_trips_trips" />
            </LinearLayout>

            <View style="@style/Widget.ST.TotalDivider" />

            <LinearLayout style="@style/Widget.ST.TotalCell">
                <TextView android:id="@+id/tvSumTopSpeed" style="@style/Widget.ST.TotalValue" tools:text="92" />
                <TextView style="@style/Widget.ST.TotalLabel" android:text="@string/st_trips_top_speed" />
            </LinearLayout>
        </LinearLayout>

        <include
            layout="@layout/include_inline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshTrips"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTripHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/st_gutter"
                android:paddingEnd="@dimen/st_gutter"
                android:paddingBottom="@dimen/st_space_6" />

            <ProgressBar
                android:id="@+id/progressTrips"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="32dp"
                android:indeterminateTint="@color/st_navy"
                android:visibility="gone" />

            <include
                layout="@layout/include_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/st_gutter"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/st_gutter" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
