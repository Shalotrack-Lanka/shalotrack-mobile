<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brand_primary"
        android:padding="16dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBackSharing"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_on_dark"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Sharing"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_dark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/status_danger"
        android:padding="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvErrorBannerMessage"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text=" "
            android:textColor="@color/text_on_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollSharingContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPendingInvitesLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PENDING INVITES"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/pendingInvitesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvSharedWithYouLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SHARED WITH YOU"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/sharedWithMeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card" />

                <TextView
                    android:id="@+id/tvNoSharedVehicles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No vehicles shared with you yet."
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VEHICLES YOU'VE SHARED"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/mySharesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card" />

                <TextView
                    android:id="@+id/tvNoMyShares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You haven't shared any vehicles yet."
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progressSharing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

</LinearLayout>