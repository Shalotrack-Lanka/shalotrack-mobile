<?xml version="1.0" encoding="utf-8"?>
<!-- Sharing: invites waiting for the customer, vehicles shared with them, and the vehicles they share
     (with revoke / cancel). "Share a vehicle" opens the invite sheet. Read on open, on return and on
     pull-to-refresh; never polled. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_canvas"
    android:orientation="vertical">

    <include layout="@layout/include_st_top_bar" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeSharing"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/sharingContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/st_gutter"
                android:paddingTop="@dimen/st_gutter"
                android:paddingEnd="@dimen/st_gutter"
                android:paddingBottom="@dimen/st_space_6">

                <include
                    layout="@layout/include_inline_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareVehicle"
                    style="@style/Widget.ST.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/st_sharing_share"
                    app:icon="@drawable/ic_st_plus"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp" />

                <ProgressBar
                    android:id="@+id/progressSharing"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:indeterminateTint="@color/st_navy" />

                <LinearLayout
                    android:id="@+id/groupSharingLists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvInvitesLabel"
                        style="@style/Widget.ST.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/st_sharing_invites" />

                    <LinearLayout
                        android:id="@+id/listInvites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/Widget.ST.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/st_sharing_with_you" />

                    <LinearLayout
                        android:id="@+id/listSharedWithMe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_st_card"
                        android:orientation="vertical"
                        android:padding="1dp" />

                    <TextView
                        android:id="@+id/tvSharedWithMeEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/st_sharing_with_you_empty"
                        android:textAppearance="@style/TextAppearance.ST.BodySmall"
                        android:visibility="gone" />

                    <TextView
                        style="@style/Widget.ST.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/st_sharing_you_shared" />

                    <LinearLayout
                        android:id="@+id/listMyShares"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_st_card"
                        android:orientation="vertical"
                        android:padding="1dp" />

                    <TextView
                        android:id="@+id/tvMySharesEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/st_sharing_you_shared_empty"
                        android:textAppearance="@style/TextAppearance.ST.BodySmall"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
