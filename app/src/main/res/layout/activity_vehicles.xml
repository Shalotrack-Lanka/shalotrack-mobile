<?xml version="1.0" encoding="utf-8"?>
<!-- Vehicle page: one vehicle. Header with live status, quick actions, tracker health (Fleet's health card),
     the owner's tools for this vehicle (live links, reminders, alert settings, geofences, sharing, statistics),
     details, tracker and removal. No map here: "Map" follows this vehicle on the Map tab, which already has
     the live position and trail. Shared and demo vehicles show only what a viewer may see. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vehiclePageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/vehiclePageTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="@dimen/st_gutter">

        <ImageButton
            android:id="@+id/btnBackVehicle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/st_action_back"
            android:src="@drawable/ic_st_back"
            app:tint="@color/st_navy" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/st_vehicle_page_title"
            android:textAppearance="@style/TextAppearance.ST.Title" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshVehiclePage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/vehiclePageScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/vehiclePageContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/st_gutter"
                android:paddingEnd="@dimen/st_gutter"
                android:paddingBottom="@dimen/st_space_6">

                <include
                    layout="@layout/include_inline_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <ProgressBar
                    android:id="@+id/progressVehiclePage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:indeterminateTint="@color/st_navy" />

                <include
                    layout="@layout/include_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/vehiclePageBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Header -->
                    <LinearLayout
                        android:id="@+id/vehicleHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_st_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvVehiclePlate"
                                style="@style/Widget.ST.Plate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="200dp"
                                tools:text="WP CAB-1234" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvVehicleStatus"
                                style="@style/Widget.ST.StatusPill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Parked" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvVehicleMakeModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textAppearance="@style/TextAppearance.ST.Headline"
                            tools:text="Toyota Aqua · 2017" />

                        <TextView
                            android:id="@+id/tvVehicleWhere"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.ST.Body"
                            tools:text="Keppetipola Road, Colombo" />

                        <TextView
                            android:id="@+id/tvVehicleUpdated"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/TextAppearance.ST.BodySmall"
                            tools:text="0 km/h · Updated 2 min ago" />

                        <TextView
                            android:id="@+id/tvVehicleSharedNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_st_tile"
                            android:padding="10dp"
                            android:textAppearance="@style/TextAppearance.ST.BodySmall"
                            android:visibility="gone"
                            tools:text="Shared by Ridmi Hesara. You can view it; only the owner can change it."
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Quick actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnActMap"
                            style="@style/Widget.ST.ActionTile"
                            android:drawableTop="@drawable/ic_st_map"
                            android:text="@string/st_nav_map" />

                        <TextView
                            android:id="@+id/btnActTrips"
                            style="@style/Widget.ST.ActionTile"
                            android:layout_marginStart="8dp"
                            android:drawableTop="@drawable/ic_st_route"
                            android:text="@string/st_nav_trips" />

                        <TextView
                            android:id="@+id/btnActAlerts"
                            style="@style/Widget.ST.ActionTile"
                            android:layout_marginStart="8dp"
                            android:drawableTop="@drawable/ic_st_bell"
                            android:text="@string/st_nav_alerts" />

                        <TextView
                            android:id="@+id/btnActNavigate"
                            style="@style/Widget.ST.ActionTile"
                            android:layout_marginStart="8dp"
                            android:drawableTop="@drawable/ic_st_navigate"
                            android:text="@string/st_vehicle_navigate" />
                    </LinearLayout>

                    <!-- Tracker health (same facts and thresholds as the Fleet health card) -->
                    <TextView
                        style="@style/Widget.ST.SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:paddingStart="4dp"
                        android:text="@string/st_health_title" />

                    <LinearLayout
                        android:id="@+id/healthCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_st_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/imgHealth"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_st_shield"
                                app:tint="@color/st_status_moving" />

                            <TextView
                                android:id="@+id/tvHealthSummary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:accessibilityLiveRegion="polite"
                                android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                                tools:text="All good" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/healthRows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvHealthFooter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/TextAppearance.ST.Caption"
                            tools:text="Last contact today, 14:32 · IMEI ends 4471" />
                    </LinearLayout>

                    <!-- Owner tools (hidden for shared / demo) -->
                    <TextView
                        android:id="@+id/tvManageLabel"
                        style="@style/Widget.ST.SectionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:paddingStart="4dp"
                        android:text="@string/st_vehicle_section_manage" />

                    <LinearLayout
                        android:id="@+id/manageCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_st_card"
                        android:divider="@drawable/bg_st_divider_inset"
                        android:orientation="vertical"
                        android:padding="1dp"
                        android:showDividers="middle" />

                    <!-- Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Widget.ST.SectionLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="4dp"
                            android:text="@string/st_vehicle_section_details" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditVehicle"
                            style="@style/Widget.ST.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/st_action_edit"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/detailsCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_st_card"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp" />

                    <!-- Tracker and removal (owner only) -->
                    <LinearLayout
                        android:id="@+id/dangerCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_st_card"
                        android:divider="@drawable/bg_st_divider_inset"
                        android:orientation="vertical"
                        android:padding="1dp"
                        android:showDividers="middle" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
