<?xml version="1.0" encoding="utf-8"?>
<!-- Alert settings for this vehicle (AlertSettings board): over-speed limit, the idling alert, and push on/off per
     alert type. Limits come from the server; a muted alert is still saved and listed in Alerts. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_space_5"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/st_space_5"
        android:paddingBottom="@dimen/st_space_6">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_st_handle"
        android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/st_alert_settings_title"
            android:textAppearance="@style/TextAppearance.ST.Title" />

        <TextView
            android:id="@+id/tvAlertSettingsFor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:visibility="gone"
            tools:text="For WP CAB-1234 only"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/progressAlertSettings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/st_navy" />

        <LinearLayout
            android:id="@+id/alertSettingsForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/st_alert_settings_speed"
                    android:textAppearance="@style/TextAppearance.ST.BodyStrong" />

                <TextView
                    android:id="@+id/tvSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                    android:textColor="@color/st_navy"
                    tools:text="80 km/h" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/st_alert_settings_speed_hint"
                android:textAppearance="@style/TextAppearance.ST.BodySmall" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSpeedLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/st_alert_settings_speed"
                android:stepSize="5"
                android:value="80"
                android:valueFrom="20"
                android:valueTo="160"
                app:labelBehavior="gone"
                app:thumbColor="@color/st_navy"
                app:trackColorActive="@color/st_navy"
                app:trackColorInactive="@color/st_line" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchIdleAlert"
                style="@style/Widget.ST.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/st_alert_settings_idle"
                android:textAppearance="@style/TextAppearance.ST.BodyStrong" />

            <LinearLayout
                android:id="@+id/idleMinutesGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/st_alert_settings_idle_after"
                        android:textAppearance="@style/TextAppearance.ST.Body" />

                    <TextView
                        android:id="@+id/tvIdleMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                        android:textColor="@color/st_navy"
                        tools:text="10 min" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderIdleMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/st_alert_settings_idle_after"
                    android:stepSize="1"
                    android:value="10"
                    android:valueFrom="1"
                    android:valueTo="60"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/st_navy"
                    app:trackColorActive="@color/st_navy"
                    app:trackColorInactive="@color/st_line" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/st_line_soft" />

            <TextView
                style="@style/Widget.ST.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/st_push_section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/st_push_section_body"
                android:textAppearance="@style/TextAppearance.ST.BodySmall" />

            <!-- One switch per alert group. Power cut shows a theft warning while it is off. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_st_card"
                android:divider="@drawable/bg_st_divider"
                android:orientation="vertical"
                android:padding="1dp"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/st_push_power_cut"
                            android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                            android:textColor="@color/st_text_1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/st_push_power_cut_detail"
                            android:textAppearance="@style/TextAppearance.ST.Caption" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPushPowerCut"
                        style="@style/Widget.ST.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/st_push_power_cut"
                        android:minHeight="48dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/powerCutWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_st_banner_warning"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_st_alert_circle"
                        app:tint="@color/st_status_offline_text" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/st_push_power_cut_warning"
                        android:textAppearance="@style/TextAppearance.ST.Caption"
                        android:textColor="@color/st_status_offline_ink" />
                </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/st_push_ignition"
                            android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                            android:textColor="@color/st_text_1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/st_push_ignition_detail"
                            android:textAppearance="@style/TextAppearance.ST.Caption" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPushIgnition"
                        style="@style/Widget.ST.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/st_push_ignition"
                        android:minHeight="48dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/st_push_overspeed"
                            android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                            android:textColor="@color/st_text_1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/st_push_overspeed_detail"
                            android:textAppearance="@style/TextAppearance.ST.Caption" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPushOverspeed"
                        style="@style/Widget.ST.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/st_push_overspeed"
                        android:minHeight="48dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/st_push_health"
                            android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                            android:textColor="@color/st_text_1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/st_push_health_detail"
                            android:textAppearance="@style/TextAppearance.ST.Caption" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPushHealth"
                        style="@style/Widget.ST.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/st_push_health"
                        android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_st_shield"
                    app:tint="@color/st_text_3" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/st_push_sos_note"
                    android:textAppearance="@style/TextAppearance.ST.Caption" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAlertSettingsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_st_banner_error"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:textColor="@color/st_danger_text"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAlertSettings"
            style="@style/Widget.ST.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:filterTouchesWhenObscured="true"
            android:text="@string/st_action_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAlertSettings"
            style="@style/Widget.ST.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_action_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
