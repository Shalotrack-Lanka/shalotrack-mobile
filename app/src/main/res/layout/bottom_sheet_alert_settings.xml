<?xml version="1.0" encoding="utf-8"?>
<!-- Alert settings for this vehicle: over-speed limit and the idling alert. Limits come from the server. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_space_5"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/st_space_5"
        android:paddingBottom="@dimen/st_space_6">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_st_handle"
        android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/st_alert_settings_title"
            android:textAppearance="@style/TextAppearance.ST.Title" />

        <ProgressBar
            android:id="@+id/progressAlertSettings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/st_navy" />

        <LinearLayout
            android:id="@+id/alertSettingsForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/st_alert_settings_speed"
                    android:textAppearance="@style/TextAppearance.ST.BodyStrong" />

                <TextView
                    android:id="@+id/tvSpeedLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                    android:textColor="@color/st_navy"
                    tools:text="80 km/h" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/st_alert_settings_speed_hint"
                android:textAppearance="@style/TextAppearance.ST.BodySmall" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSpeedLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/st_alert_settings_speed"
                android:stepSize="5"
                android:value="80"
                android:valueFrom="20"
                android:valueTo="160"
                app:labelBehavior="gone"
                app:thumbColor="@color/st_navy"
                app:trackColorActive="@color/st_navy"
                app:trackColorInactive="@color/st_line" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchIdleAlert"
                style="@style/Widget.ST.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/st_alert_settings_idle"
                android:textAppearance="@style/TextAppearance.ST.BodyStrong" />

            <LinearLayout
                android:id="@+id/idleMinutesGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/st_alert_settings_idle_after"
                        android:textAppearance="@style/TextAppearance.ST.Body" />

                    <TextView
                        android:id="@+id/tvIdleMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                        android:textColor="@color/st_navy"
                        tools:text="10 min" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderIdleMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/st_alert_settings_idle_after"
                    android:stepSize="1"
                    android:value="10"
                    android:valueFrom="1"
                    android:valueTo="60"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/st_navy"
                    app:trackColorActive="@color/st_navy"
                    app:trackColorInactive="@color/st_line" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAlertSettingsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_st_banner_error"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:textColor="@color/st_danger_text"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAlertSettings"
            style="@style/Widget.ST.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:filterTouchesWhenObscured="true"
            android:text="@string/st_action_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelAlertSettings"
            style="@style/Widget.ST.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_action_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
