<?xml version="1.0" encoding="utf-8"?>
<!-- App plan: what you have now, the plans with prices from the server's price list, and the request.
     After a request the sheet shows the server's payment instructions (selectable, so they can be copied). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_space_5"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/st_space_5"
        android:paddingBottom="@dimen/st_space_6">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_st_handle"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/planForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/st_plan_title"
                android:textAppearance="@style/TextAppearance.ST.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/st_plan_body"
                android:textAppearance="@style/TextAppearance.ST.BodySmall" />

            <TextView
                android:id="@+id/tvPlanCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_st_tile"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textAppearance="@style/TextAppearance.ST.Body"
                android:visibility="gone"
                tools:text="Your plan: 1 year, until 12 Mar 2027"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/progressPlans"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="20dp"
                android:indeterminateTint="@color/st_navy" />

            <LinearLayout
                android:id="@+id/planOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvPlanError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_st_banner_error"
                android:padding="12dp"
                android:textAppearance="@style/TextAppearance.ST.BodySmall"
                android:textColor="@color/st_danger_text"
                android:visibility="gone"
                tools:text="You already have a plan request in progress."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlanContinue"
                style="@style/Widget.ST.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:filterTouchesWhenObscured="true"
                android:text="@string/st_plan_request" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlanCancel"
                style="@style/Widget.ST.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/st_action_cancel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/planDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPlanDoneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/st_plan_done_title"
                android:textAppearance="@style/TextAppearance.ST.Title" />

            <TextView
                android:id="@+id/tvPlanDoneBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_st_tile"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:textAppearance="@style/TextAppearance.ST.Body"
                android:textIsSelectable="true"
                tools:text="Pay Rs. 2,999 to ShaloTrack (Pvt) Ltd..." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlanDone"
                style="@style/Widget.ST.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/st_action_done" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
