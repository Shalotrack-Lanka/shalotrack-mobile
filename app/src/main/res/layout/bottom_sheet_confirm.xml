<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmation for an action that cannot be undone (remove vehicle, unlink tracker, sign out).
     A bottom sheet in the app's own style, never a system AlertDialog. Errors show inside the sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/st_space_5"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/st_space_5"
    android:paddingBottom="@dimen/st_space_6">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_st_handle"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvConfirmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.ST.Title"
        tools:text="Remove WP CAB-1234?" />

    <TextView
        android:id="@+id/tvConfirmBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:textAppearance="@style/TextAppearance.ST.Body"
        tools:text="The vehicle leaves your account and its tracker is freed so it can be linked to another vehicle. Trips and alerts are kept." />

    <TextView
        android:id="@+id/tvConfirmError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_st_banner_error"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.ST.BodySmall"
        android:textColor="@color/st_danger_text"
        android:visibility="gone"
        tools:text="Couldn't remove the vehicle. Check your connection and try again."
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmAction"
        style="@style/Widget.ST.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:filterTouchesWhenObscured="true"
        tools:text="Remove vehicle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmCancel"
        style="@style/Widget.ST.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/st_action_cancel" />
</LinearLayout>
