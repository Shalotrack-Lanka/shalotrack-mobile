<?xml version="1.0" encoding="utf-8"?>
<!-- New or edit geofence. The circle on the map follows the size slider live. Remove asks inside the
     sheet (no stacked dialogs). Errors show on the field or in the sheet. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_space_5"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/st_space_5"
        android:paddingBottom="@dimen/st_space_6">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_st_handle"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/geofenceForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGeofenceSheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.ST.Title"
                tools:text="New geofence" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGeofenceName"
                style="@style/Widget.ST.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/st_geofence_name_hint"
                app:counterEnabled="true"
                app:counterMaxLength="50">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGeofenceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLength="50"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/st_geofence_size"
                    android:textAppearance="@style/TextAppearance.ST.BodyStrong" />

                <TextView
                    android:id="@+id/tvRadiusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                    android:textColor="@color/st_navy"
                    tools:text="200 m" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/st_geofence_size"
                android:stepSize="50"
                android:value="200"
                android:valueFrom="50"
                android:valueTo="5000"
                app:labelBehavior="gone"
                app:thumbColor="@color/st_navy"
                app:trackColorActive="@color/st_navy"
                app:trackColorInactive="@color/st_line" />

            <LinearLayout
                android:id="@+id/rowGeofenceScope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_st_outline_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/st_geofence_applies_to"
                        android:textAppearance="@style/TextAppearance.ST.Caption" />

                    <TextView
                        android:id="@+id/tvGeofenceScope"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                        tools:text="All my vehicles" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_st_chevron_down"
                    app:tint="@color/st_text_3" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAlertOnEnter"
                style="@style/Widget.ST.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/st_geofence_alert_enter"
                android:textAppearance="@style/TextAppearance.ST.Body" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAlertOnExit"
                style="@style/Widget.ST.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/st_geofence_alert_exit"
                android:textAppearance="@style/TextAppearance.ST.Body" />

            <TextView
                android:id="@+id/tvGeofenceError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_st_banner_error"
                android:padding="12dp"
                android:textAppearance="@style/TextAppearance.ST.BodySmall"
                android:textColor="@color/st_danger_text"
                android:visibility="gone"
                tools:text="Couldn't save. Check your connection and try again."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveGeofence"
                style="@style/Widget.ST.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:filterTouchesWhenObscured="true"
                android:text="@string/st_action_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveGeofence"
                style="@style/Widget.ST.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/st_geofence_remove"
                android:textColor="@color/st_danger_text"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelGeofence"
                style="@style/Widget.ST.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/st_action_cancel" />
        </LinearLayout>

        <!-- Remove: asked here, not in a second dialog -->
        <LinearLayout
            android:id="@+id/geofenceRemoveConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRemoveGeofenceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.ST.Title"
                tools:text="Remove Home?" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/st_geofence_remove_body"
                android:textAppearance="@style/TextAppearance.ST.Body" />

            <TextView
                android:id="@+id/tvRemoveGeofenceError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_st_banner_error"
                android:padding="12dp"
                android:textAppearance="@style/TextAppearance.ST.BodySmall"
                android:textColor="@color/st_danger_text"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmRemoveGeofence"
                style="@style/Widget.ST.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:filterTouchesWhenObscured="true"
                android:text="@string/st_geofence_remove" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeepGeofence"
                style="@style/Widget.ST.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/st_geofence_keep" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
