<?xml version="1.0" encoding="utf-8"?>
<!-- Live location links: a link anyone can open (no app, no sign-in) that shows this vehicle live until it
     expires. Up to 3 at a time, 1 to 24 hours. The link is shown once, right after it is made (the server
     keeps only a hash), so it can be copied or shared from here; later the list shows only when each ends. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_space_5"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/st_space_5"
        android:paddingBottom="@dimen/st_space_6">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_st_handle"
        android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/st_live_title"
            android:textAppearance="@style/TextAppearance.ST.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/st_live_body"
            android:textAppearance="@style/TextAppearance.ST.BodySmall" />

        <!-- New link, shown once -->
        <LinearLayout
            android:id="@+id/liveNewLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_st_tile"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvLiveNewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                tools:text="Link ready, ends today at 18:30" />

            <TextView
                android:id="@+id/tvLiveNewUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/st_text_1"
                android:textIsSelectable="true"
                android:textSize="13sp"
                tools:text="https://fleet.shalotrack.com/live/abc..." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLiveCopy"
                    style="@style/Widget.ST.Button.Secondary.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/st_live_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLiveShare"
                    style="@style/Widget.ST.Button.Primary.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/st_live_share" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Widget.ST.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/st_live_how_long" />

        <LinearLayout
            android:id="@+id/liveDurations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/chipLive1h" style="@style/Widget.ST.FilterChip" android:layout_width="0dp" android:layout_weight="1" android:text="@string/st_live_1h" />
            <TextView android:id="@+id/chipLive4h" style="@style/Widget.ST.FilterChip" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/st_live_4h" />
            <TextView android:id="@+id/chipLive8h" style="@style/Widget.ST.FilterChip" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/st_live_8h" />
            <TextView android:id="@+id/chipLive24h" style="@style/Widget.ST.FilterChip" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/st_live_24h" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLiveError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_st_banner_error"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:textColor="@color/st_danger_text"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLiveCreate"
            style="@style/Widget.ST.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:filterTouchesWhenObscured="true"
            android:text="@string/st_live_create" />

        <TextView
            android:id="@+id/tvLiveActiveLabel"
            style="@style/Widget.ST.SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/st_live_active"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressLive"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/st_navy" />

        <LinearLayout
            android:id="@+id/liveList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_st_card"
            android:divider="@drawable/bg_st_divider"
            android:orientation="vertical"
            android:padding="1dp"
            android:showDividers="middle"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
