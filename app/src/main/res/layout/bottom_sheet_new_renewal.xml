<?xml version="1.0" encoding="utf-8"?>
<!-- Renew a vehicle: which vehicle (own only), how long (prices from the server), an optional bank
     reference, and how payment works. The amount is never sent by the phone; the server sets it. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_space_5"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/st_space_5"
        android:paddingBottom="@dimen/st_space_6">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_st_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/st_renewal_new_title"
            android:textAppearance="@style/TextAppearance.ST.Title" />

        <include
            layout="@layout/include_st_vehicle_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:text="@string/st_renewal_for"
            android:textAppearance="@style/TextAppearance.ST.BodyStrong" />

        <ProgressBar
            android:id="@+id/progressRenewalPackages"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="10dp"
            android:indeterminateTint="@color/st_navy" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />

        <TextView
            android:id="@+id/tvRenewalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:textColor="@color/st_navy"
            tools:text="LKR 6,000 · runs 1 year from the day we approve" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRenewalReference"
            style="@style/Widget.ST.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/st_renewal_reference_field"
            app:placeholderText="@string/st_renewal_reference_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRenewalReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="40"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_st_banner_info"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_st_info"
                app:tint="@color/st_tone_info_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/st_renewal_how"
                android:textAppearance="@style/TextAppearance.ST.BodySmall"
                android:textColor="@color/st_tone_info_text" />
        </LinearLayout>

        <include
            layout="@layout/include_inline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRenewalContinue"
            style="@style/Widget.ST.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:filterTouchesWhenObscured="true"
            android:text="@string/st_renewal_continue"
            tools:enabled="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRenewalSheetCancel"
            style="@style/Widget.ST.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_action_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
