<?xml version="1.0" encoding="utf-8"?>
<!-- Change the sign-in number: new number, then the 6-digit code texted to it. The server requires a sign-in in
     the last 10 minutes, revokes every session afterwards and texts the old number. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_space_5"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/st_space_5"
        android:paddingBottom="@dimen/st_space_6">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_st_handle"
        android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvPhoneChangeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/st_phone_change_title"
            android:textAppearance="@style/TextAppearance.ST.Title" />

        <TextView
            android:id="@+id/tvPhoneChangeBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/st_phone_change_body"
            android:textAppearance="@style/TextAppearance.ST.BodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNewPhone"
            style="@style/Widget.ST.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/st_phone_change_new_hint"
            app:prefixText="+94 ">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="phoneNational"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:maxLength="12"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhoneCode"
            style="@style/Widget.ST.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/st_phone_change_code_hint"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhoneCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="smsOTPCode"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:letterSpacing="0.3"
                android:maxLength="6"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvPhoneChangeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_st_banner_error"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:textColor="@color/st_danger_text"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhoneChangeAction"
            style="@style/Widget.ST.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:filterTouchesWhenObscured="true"
            android:text="@string/st_phone_change_send" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhoneChangeSecondary"
            style="@style/Widget.ST.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_action_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
