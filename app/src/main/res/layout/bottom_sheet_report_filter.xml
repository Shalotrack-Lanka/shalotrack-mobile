<?xml version="1.0" encoding="utf-8"?>
<!-- Report generation feature: the single reusable filter step (vehicle +
     date range) launched by every "real" card in bottom_sheet_reports_menu
     (KM/Trip/Alert/Stop Alert: see ReportFilterBottomSheet.java). This
     layout previously existed but was never inflated anywhere (dead XML),
     and had two issues fixed while bringing it to life:
       1. A stray trailing character after the root </LinearLayout> close
          tag, which would have failed the build the moment this file was
          actually referenced.
       2. A "Records Per Page" spinner that doesn't map onto ANY of the
          four target screens' real needs (Trip History does its own
          day-chunked lazy loading; the Value/KM screen doesn't paginate at
          all; the new Stop/Alert report screens fetch their whole,
          90-day-capped range in one call): removed rather than wired to
          nothing, since an orphaned "records per page" control with no
          real effect would be dishonest UI. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Reports"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseFilter"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_edit_text_rounded"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#555555" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvSelectedReportTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="KM Report"
        android:textColor="#222222"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Vehicle Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Vehicle:"
        android:textColor="#444444"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit_text_rounded"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <Spinner
            android:id="@+id/spinnerDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null" />
    </LinearLayout>

    <!-- From Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="From Date:"
        android:textColor="#444444"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvFromDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit_text_rounded"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:textColor="#333333"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true" />

    <!-- To Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="To Date:"
        android:textColor="#444444"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvToDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit_text_rounded"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:textColor="#333333"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/tvFilterError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="#D32F2F"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitReport"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="Submit"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textAllCaps="false"
        app:backgroundTint="#0072FF"
        app:cornerRadius="6dp" />

</LinearLayout>