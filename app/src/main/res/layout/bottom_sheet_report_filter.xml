<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Reports"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseFilter"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_edit_text_rounded"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#555555" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvSelectedReportTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="KM Report"
        android:textColor="#222222"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Device Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Device:"
        android:textColor="#444444"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit_text_rounded"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <Spinner
            android:id="@+id/spinnerDevices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null" />
    </LinearLayout>

    <!-- From Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="From Date:"
        android:textColor="#444444"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvFromDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit_text_rounded"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="2026-06-28"
        android:textColor="#333333"
        android:textSize="16sp" />

    <!-- To Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="To Date:"
        android:textColor="#444444"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvToDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit_text_rounded"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="2026-07-29"
        android:textColor="#333333"
        android:textSize="16sp" />

    <!-- Records Per Page -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Records Per Page:"
        android:textColor="#444444"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edit_text_rounded"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <Spinner
            android:id="@+id/spinnerRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitReport"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="Submit"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textAllCaps="false"
        app:backgroundTint="#0072FF"
        app:cornerRadius="6dp" />

</LinearLayout>