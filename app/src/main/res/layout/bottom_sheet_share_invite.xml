<?xml version="1.0" encoding="utf-8"?>
<!-- Share a vehicle: which of the customer's vehicles, and the other person's mobile number. The reply is
     the same whether or not the number has an account, so this sheet never says either way. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_space_5"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/st_space_5"
        android:paddingBottom="@dimen/st_space_6">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_st_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/st_share_invite_title"
            android:textAppearance="@style/TextAppearance.ST.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_share_invite_body"
            android:textAppearance="@style/TextAppearance.ST.BodySmall" />

        <include
            layout="@layout/include_st_vehicle_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSharePhone"
            style="@style/Widget.ST.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/st_share_phone"
            app:helperText="@string/st_share_phone_helper"
            app:prefixText="+94 ">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSharePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="phone"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:maxLength="14"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <include
            layout="@layout/include_inline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareSend"
            style="@style/Widget.ST.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:filterTouchesWhenObscured="true"
            android:text="@string/st_share_send" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareCancel"
            style="@style/Widget.ST.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/st_action_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
