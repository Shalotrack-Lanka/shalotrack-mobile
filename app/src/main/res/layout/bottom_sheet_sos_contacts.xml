<?xml version="1.0" encoding="utf-8"?>
<!-- After an SOS is sent: who to call now. National numbers first, then the customer's own contacts. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/st_space_5"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/st_space_5"
        android:paddingBottom="@dimen/st_space_6">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_st_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/st_sos_sent_title"
            android:textAppearance="@style/TextAppearance.ST.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/st_sos_sent_body"
            android:textAppearance="@style/TextAppearance.ST.Body" />

        <TextView
            style="@style/Widget.ST.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/st_sos_national" />

        <LinearLayout
            android:id="@+id/nationalNumbersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_st_card"
            android:orientation="vertical"
            android:padding="1dp" />

        <TextView
            style="@style/Widget.ST.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/st_sos_your_contacts" />

        <LinearLayout
            android:id="@+id/personalContactsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_st_card"
            android:orientation="vertical"
            android:padding="1dp" />

        <TextView
            android:id="@+id/tvNoContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/st_sos_no_contacts"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
