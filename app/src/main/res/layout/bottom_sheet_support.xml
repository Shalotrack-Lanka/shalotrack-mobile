<?xml version="1.0" encoding="utf-8"?>
<!-- Contact ShaloTrack: call, WhatsApp or email. Complaints have their own row on the More tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/st_space_5"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/st_space_5"
    android:paddingBottom="@dimen/st_space_6">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_st_handle"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:accessibilityHeading="true"
        android:text="@string/st_support_title"
        android:textAppearance="@style/TextAppearance.ST.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/st_support_body"
        android:textAppearance="@style/TextAppearance.ST.BodySmall" />

    <TextView
        android:id="@+id/tvSupportError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_st_banner_error"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.ST.BodySmall"
        android:textColor="@color/st_danger_text"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/supportRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_st_card"
        android:divider="@drawable/bg_st_divider_inset"
        android:orientation="vertical"
        android:padding="1dp"
        android:showDividers="middle" />
</LinearLayout>
