<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="12dp">

        <!-- Colored icon chip: color/glyph set in code per alert type
             (AlertAdapter), not a drawable resource, matching how the
             unread dot was already handled, same approach, just
             applied more visibly. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAlertIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvAlertIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAlertType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ignition On"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0A2463" />

            <TextView
                android:id="@+id/tvAlertMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Test: ignition turned on"
                android:textSize="13sp"
                android:textColor="#555555"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvAlertVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="WP JK 9931"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#9E9E9E" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvAlertTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:02 AM"
                android:textSize="11sp"
                android:textColor="#888888" />

            <!-- Unread indicator dot: shape/color set in code
                 (AlertAdapter), matching the original approach exactly,
                 just repositioned under the time instead of before the
                 whole row. -->
            <View
                android:id="@+id/dotUnread"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:layout_gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="60dp"
        android:background="#F0F0F0" />

</LinearLayout>