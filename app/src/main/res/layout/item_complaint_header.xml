<?xml version="1.0" encoding="utf-8"?>
<!-- Top of a complaint thread: category, state, vehicle, when it was opened, then the "Conversation" label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/complaintHeaderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_st_card"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.ST.TitleSmall"
                tools:text="Device issue" />

            <TextView
                android:id="@+id/tvDetailStatus"
                style="@style/Widget.ST.StatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="With dealer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailPlate"
                style="@style/Widget.ST.Plate.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="WP CAB-1234" />

            <TextView
                android:id="@+id/tvDetailOpened"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.ST.Caption"
                tools:text="Opened 24 Nov 2026" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Widget.ST.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/st_complaint_conversation" />
</LinearLayout>
