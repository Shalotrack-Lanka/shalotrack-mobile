<?xml version="1.0" encoding="utf-8"?>
<!-- One vehicle's tracker: linked (last 4 of the IMEI, Unlink) or not (Link opens the IMEI form here). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_st_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDevicePlate"
            style="@style/Widget.ST.Plate.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="WP CAB-1234" />

        <TextView
            android:id="@+id/tvDeviceVehicle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            tools:text="Toyota Aqua" />

        <TextView
            android:id="@+id/tvDeviceState"
            style="@style/Widget.ST.StatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Linked" />
    </LinearLayout>

    <!-- Linked -->
    <LinearLayout
        android:id="@+id/groupLinked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_st_device"
            app:tint="@color/st_text_3" />

        <TextView
            android:id="@+id/tvDeviceImei"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            tools:text="Tracker ending 3787" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlink"
            style="@style/Widget.ST.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/st_tracker_unlink"
            android:textColor="@color/st_danger_text" />
    </LinearLayout>

    <!-- Not linked -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShowLink"
        style="@style/Widget.ST.Button.Secondary.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/st_tracker_link"
        android:visibility="gone"
        app:icon="@drawable/ic_st_plus"
        app:iconPadding="6dp"
        app:iconSize="16dp" />

    <LinearLayout
        android:id="@+id/groupLinkForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutImei"
            style="@style/Widget.ST.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/st_tracker_imei"
            app:counterEnabled="true"
            app:counterMaxLength="15"
            app:helperText="@string/st_tracker_imei_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etImei"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789"
                android:fontFeatureSettings="tnum"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="15"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinkConfirm"
                style="@style/Widget.ST.Button.Secondary.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:filterTouchesWhenObscured="true"
                android:text="@string/st_tracker_check_link" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinkCancel"
                style="@style/Widget.ST.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/st_action_cancel" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvDeviceRowError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_st_banner_error"
        android:padding="10dp"
        android:textAppearance="@style/TextAppearance.ST.BodySmall"
        android:textColor="@color/st_danger_text"
        android:visibility="gone" />
</LinearLayout>
