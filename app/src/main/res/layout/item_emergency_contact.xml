<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">

    <!-- Avatar circle with initials, matching the approved emergency
         contacts mockup, initials computed in the adapter, same
         rounded-card background already established for Value's stat
         cards, reused here for visual consistency across the app. -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_circle_gray">
        <TextView
            android:id="@+id/tvContactInitials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="?"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_accent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvContactPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+94 7X XXX XXXX"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvContactRelationship"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=" "
            android:textSize="11sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- NEW: matches the approved mockup's tap-to-call button, same
         green-circle style already used in the post-SOS call sheet. -->
    <ImageView
        android:id="@+id/btnCallContact"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_success"
        android:padding="8dp"
        android:src="@drawable/ic_phone_call"
        app:tint="@color/status_success"
        android:contentDescription="Call contact" />

    <ImageView
        android:id="@+id/btnDeleteContact"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/status_danger"
        android:contentDescription="Remove contact"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp" />

</LinearLayout>