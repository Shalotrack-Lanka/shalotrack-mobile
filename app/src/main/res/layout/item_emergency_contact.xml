<?xml version="1.0" encoding="utf-8"?>
<!-- One emergency contact: initials, name, number and relationship, remove. Tapping the row opens the dialer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/st_row_height"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:id="@+id/contactCall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/st_row_height"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvContactInitials"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_st_avatar"
            android:backgroundTint="@color/st_navy_100"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/st_navy"
            android:textSize="14sp"
            tools:text="NP" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvContactName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ST.BodyStrong"
                tools:text="Nimal Perera" />

            <TextView
                android:id="@+id/tvContactDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.ST.Caption"
                tools:text="+94 77 123 4567 · Brother" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeleteContact"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_st_trash"
        app:tint="@color/st_text_3"
        tools:contentDescription="Remove Nimal Perera" />
</LinearLayout>
