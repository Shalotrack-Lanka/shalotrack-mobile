<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/circleIconBg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_circle_gray">
        <ImageView
            android:id="@+id/imgGeofenceIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="@color/brand_accent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGeofenceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Geofence Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvGeofenceCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="200m radius \u2022 All vehicles \u2022 Enter + Exit"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchGeofenceActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>