<?xml version="1.0" encoding="utf-8"?>
<!-- NEW: KM Report daily breakdown row. Same rounded-card convention as
     item_stop_report.xml/item_alert.xml so this reads as part of the same
     app rather than a bolted-on one-off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_stat_card"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvKmDayDate"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Mon, 1 Sep 2026"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvKmDayDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 km"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/brand_accent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvKmDayTrips"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="0 trips"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvKmDayStops"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="0 stops"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvKmDaySpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Avg 0 km/h · Max 0 km/h"
        android:textSize="12sp"
        android:textColor="@color/text_muted" />

    <TextView
        android:id="@+id/tvKmDayIgnitionOn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0m ignition on"
        android:textSize="12sp"
        android:textColor="@color/text_muted" />

</LinearLayout>