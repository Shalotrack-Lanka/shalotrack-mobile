<?xml version="1.0" encoding="utf-8"?>
<!-- One renewal request: plate, state, package and amount, a note, and the actions it still allows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_st_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/renewalSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRenewalPlate"
                style="@style/Widget.ST.Plate.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="WP CAB-1234" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRenewalStatus"
                style="@style/Widget.ST.StatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Waiting for your slip" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRenewalDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.ST.BodyStrong"
            tools:text="1 year · LKR 6,000" />

        <TextView
            android:id="@+id/tvRenewalNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.ST.Caption"
            tools:text="Reference HNB-55120 · asked 25 Nov 2026" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupRenewalActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRenewalUpload"
            style="@style/Widget.ST.Button.Secondary.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:filterTouchesWhenObscured="true"
            app:icon="@drawable/ic_st_file"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            tools:text="Upload slip" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRenewalCancel"
            style="@style/Widget.ST.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/st_renewal_cancel"
            android:textColor="@color/st_danger_text" />
    </LinearLayout>
</LinearLayout>
