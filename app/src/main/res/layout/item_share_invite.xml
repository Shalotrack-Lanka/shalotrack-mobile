<?xml version="1.0" encoding="utf-8"?>
<!-- An invite waiting for the customer: the vehicle, who is sharing it, Accept / Decline. Errors stay on the card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_st_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvInvitePlate"
            style="@style/Widget.ST.Plate.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="WP KX-0091" />

        <TextView
            android:id="@+id/tvInviteVehicle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            tools:text="Suzuki Wagon R" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvInviteBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAppearance="@style/TextAppearance.ST.Body"
        tools:text="Nimal Perera wants to share this vehicle with you. You'll see where it is and its trips." />

    <TextView
        android:id="@+id/tvInviteError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_st_banner_error"
        android:padding="10dp"
        android:textAppearance="@style/TextAppearance.ST.BodySmall"
        android:textColor="@color/st_danger_text"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInviteAccept"
            style="@style/Widget.ST.Button.Primary.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/st_sharing_accept" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInviteDecline"
            style="@style/Widget.ST.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/st_sharing_decline" />
    </LinearLayout>
</LinearLayout>
