<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <!-- Left Timeline Line + Clickable Trip Icon -->
    <LinearLayout
        android:id="@+id/layoutTripIconClick"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTripIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:backgroundTint="#1877F2"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#FFFFFF" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="#CBD5E1" />
    </LinearLayout>

    <!-- Right Side Trip Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Trip Distance & Post Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTripDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="86 km Trip"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostTrip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:text="Share"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:backgroundTint="#1877F2"
                app:cornerRadius="18dp" />
        </RelativeLayout>

        <!-- Route Addresses -->
        <TextView
            android:id="@+id/tvTripAddresses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1054, Sareya - Ghasi Pakar, Banar Jhula"
            android:textColor="#1E293B"
            android:textSize="15sp" />

        <!-- Time and Duration -->
        <TextView
            android:id="@+id/tvTripTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="05:42 PM - 07:32 PM (1h 50m)"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Top Speed Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_edit_text_rounded"
            android:backgroundTint="#EFF6FF"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvTopSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top Speed: 89 kph"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Map thumbnail: a STATIC image (Google Static Maps API), not a
             live embedded MapView, a scrolling list of live interactive
             maps is a well-known performance/memory problem. Shows start
             (green)/end (red) markers with a straight connecting line, NOT
             the actual driven route (that needs the full per-trip GPS
             point array, which this list-row granularity intentionally
             doesn't fetch, see TripHistoryAdapter for the real curved
             route in TripDetailActivity instead). Loaded/cached by
             StaticMapLoader, using the same Maps API key already
             configured for the SDK elsewhere in this app. -->
        <ImageView
            android:id="@+id/ivTripMap"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="10dp"
            android:background="#E2E8F0"
            android:scaleType="centerCrop"
            android:contentDescription="Trip route map" />

        <!-- Save Place Buttons (Start & End) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Start Place Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnSavePlaceStart"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_edit_text_rounded"
                    android:backgroundTint="#FED7AA"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔔 Save Place"
                        android:textColor="#7C2D12"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStartPlaceName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="1054, Sareya"
                    android:textColor="#0F172A"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- End Place Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnSavePlaceEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_edit_text_rounded"
                    android:backgroundTint="#FED7AA"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔔 Save Place"
                        android:textColor="#7C2D12"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEndPlaceName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ghasi Pakar, Banar Jhula"
                    android:textColor="#0F172A"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#E2E8F0" />
    </LinearLayout>
</LinearLayout>