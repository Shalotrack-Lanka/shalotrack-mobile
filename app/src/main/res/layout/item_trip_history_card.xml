<?xml version="1.0" encoding="utf-8"?>
<!-- One trip: route thumbnail (Maps SDK lite mode: free, uses the app's restricted key), times,
     from / to and the numbers. Tap opens the playback. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tripCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_st_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_st_tile"
        android:importantForAccessibility="noHideDescendants">

        <com.google.android.gms.maps.MapView
            android:id="@+id/liteMapTrip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            map:liteMode="true"
            map:mapType="normal" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTripTimes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/archivo_bold"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/st_text_1"
                android:textSize="16sp"
                tools:text="08:12 – 08:47" />

            <TextView
                android:id="@+id/tvTripDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ST.Label"
                tools:text="18.2 km" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTripStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:textColor="@color/st_text_1"
            tools:text="Home, Kadawatha" />

        <TextView
            android:id="@+id/tvTripEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.ST.BodySmall"
            android:textColor="@color/st_text_1"
            tools:text="Office, Union Place" />

        <TextView
            android:id="@+id/tvTripMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.ST.Caption"
            tools:text="35 min · max 74 km/h" />
    </LinearLayout>
</LinearLayout>
