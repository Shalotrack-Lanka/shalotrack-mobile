<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thu - 5 Trips"
            android:textColor="#1877F2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDaySummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Total - 472 km in 9h 22m"
            android:textColor="#64748B"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnToggleDay"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_edit_text_rounded"
        android:backgroundTint="#E2E8F0"
        android:gravity="center"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tvToggleDayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶ Day"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>