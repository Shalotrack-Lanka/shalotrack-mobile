<?xml version="1.0" encoding="utf-8"?>
<!-- One vehicle row (Vehicles tab and the "Other vehicles" list on the map). Plate first, status on the
     right, a red warning line when the tracker reports a problem. Swipe left reveals Remove (owner only). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Revealed behind the row when swiped left -->
    <TextView
        android:id="@+id/btnVehicleListSwipeRemove"
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/st_danger"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="@string/st_action_remove"
        android:textColor="@color/st_surface"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/layoutVehicleListForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/st_surface"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/vehicleRowClickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_st_row"
            android:duplicateParentState="true"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/vehicleIconRing"
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/imgVehicleListIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_st_car" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVehicleListPlate"
                    style="@style/Widget.ST.Plate.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    tools:text="WP CAB-1234" />

                <TextView
                    android:id="@+id/tvVehicleListCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.ST.BodySmall"
                    tools:text="Toyota Aqua · 42 km/h" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vehicleRowEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVehicleListStatus"
                    style="@style/Widget.ST.StatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Moving" />

                <TextView
                    android:id="@+id/tvVehicleListTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.ST.Caption"
                    tools:text="12 s ago" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVehicleListLink"
                style="@style/Widget.ST.Button.Secondary.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/st_vehicle_link_tracker"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Shown only when the tracker reports a problem (power cut) or the vehicle is the demo/shared one -->
        <TextView
            android:id="@+id/tvVehicleListNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_st_tile"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textAppearance="@style/TextAppearance.ST.Caption"
            android:visibility="gone"
            tools:text="Tracker cut from vehicle power"
            tools:visibility="visible" />

        <View
            android:id="@+id/vehicleRowDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/st_line_soft" />
    </LinearLayout>
</FrameLayout>
