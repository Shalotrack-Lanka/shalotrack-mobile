<?xml version="1.0" encoding="utf-8"?>
<!-- Letstrack-style flat row (from real reference screenshots): no card
     border/elevation/per-row corner radius, just a continuous list with a
     hairline divider between rows. Swipe-to-reveal Remove still lives
     behind it (Letstrack's own row shows no delete affordance at all,
     which lines up with our existing decision to keep Remove off the
     permanent face). Heart icon replaces the old star, purely visual
     parity, still decorative/unwired, same as the star was before it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Static background reveal layer. Never translated, only the
         foreground row on top of it moves. Full-bleed (no horizontal
         margin) to match the flat, edge-to-edge list style. -->
    <LinearLayout
        android:id="@+id/layoutVehicleListSwipeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/status_danger"
        android:orientation="horizontal"
        android:gravity="center_vertical|end">

        <LinearLayout
            android:id="@+id/btnVehicleListSwipeRemove"
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="Remove vehicle"
                app:tint="@color/surface_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Remove"
                android:textColor="@color/surface_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Foreground: flat row, no MaterialCardView. -->
    <LinearLayout
        android:id="@+id/layoutVehicleListForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="#E6F0FA"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgVehicleListIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_car"
                    android:contentDescription="@string/desc_car_icon"
                    app:tint="#1976D2" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVehicleListName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="JAPAN Mazda"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvVehicleListStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Parked"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary" />

                <!-- Caption: plate + GPS-link status. NOT a "last seen"
                     timestamp, DashboardVehicle carries no timestamp
                     field, see adapter comment. -->
                <TextView
                    android:id="@+id/tvVehicleListCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="WP JK 9931 &#8226; GPS Device Linked"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgVehicleListFavorite"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="@string/desc_favorite"
                app:tint="#BDBDBD" />

        </LinearLayout>

        <!-- Full-bleed hairline divider, matching the flat reference list
             (no inset under the icon/text, spans edge to edge). -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0" />

    </LinearLayout>

</FrameLayout>