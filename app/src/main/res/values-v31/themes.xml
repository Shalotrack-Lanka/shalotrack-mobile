<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: real blur of whatever is behind the bottom sheet (the glass effect). Phones that turn
         cross-window blur off (battery saver, some low-end devices) automatically fall back to the plain dim. -->
    <style name="ThemeOverlay.ShaloTrack.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ShaloTrack.BottomSheet</item>
        <item name="android:backgroundDimAmount">0.22</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">18dp</item>
    </style>
</resources>
