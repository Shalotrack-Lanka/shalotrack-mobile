<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ════════════════════════════════════════════════════════════
         ShaloTrack design system: colour tokens (Daylight)
         Brand navy and signal orange are the same values as the website and the Fleet portal.
         Rules:
           - Orange marks the ONE next action on a screen (primary button, selected tab marker, unread dot).
           - Status colours (st_status_*) carry vehicle data only. Never use them for decoration.
           - Text on white must pass 4.5:1. st_text_4 is for icons and disabled states only, never for text.
         New screens use the st_* tokens. The older names further down are kept so screens that have not
         been redesigned yet still compile; they now point at the same palette.
         ════════════════════════════════════════════════════════════ -->

    <!-- Brand -->
    <color name="st_navy">#021F4A</color>
    <color name="st_navy_700">#163C78</color>
    <color name="st_navy_100">#EEF1F6</color>
    <color name="st_navy_950">#011634</color>
    <color name="st_signal">#FA6908</color>
    <color name="st_signal_pressed">#E25A00</color>
    <color name="st_signal_50">#FFF4EC</color>
    <color name="st_signal_text">#A34405</color>

    <!-- Surfaces and lines -->
    <color name="st_canvas">#F6F7F9</color>
    <color name="st_surface">#FFFFFF</color>
    <color name="st_surface_sunken">#EAECF0</color>
    <color name="st_line">#E4E7EC</color>
    <color name="st_line_soft">#EEF0F3</color>
    <color name="st_scrim">#52021F4A</color>

    <!-- Text (contrast on white: 1 = 16:1, 2 = 7.4:1, 3 = 5:1) -->
    <color name="st_text_1">#0F1E36</color>
    <color name="st_text_2">#475467</color>
    <color name="st_text_3">#667085</color>
    <color name="st_text_4">#98A2B3</color>
    <color name="st_text_on_navy">#FFFFFF</color>
    <color name="st_text_on_navy_2">#C7D2E4</color>

    <!-- Vehicle status: dot / text / background -->
    <color name="st_status_moving">#16A34A</color>
