    <color name="st_status_nodevice_bg">#FEF3F2</color>
    <color name="st_status_nodevice_line">#FDA29B</color>

    <!-- Feedback (same family as the status colours) -->
    <color name="st_danger">#D92D20</color>
    <color name="st_danger_text">#B42318</color>
    <color name="st_danger_bg">#FEF3F2</color>
    <color name="st_danger_line">#FDA29B</color>
    <color name="st_success_text">#15803D</color>

