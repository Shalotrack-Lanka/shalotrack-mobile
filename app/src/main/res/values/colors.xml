    <color name="st_status_parked_bg">#EEF1F6</color>

    <color name="st_status_offline">#F59E0B</color>
    <color name="st_status_offline_text">#B45309</color>
    <color name="st_status_offline_bg">#FFFAEB</color>
    <color name="st_status_offline_line">#FEDF89</color>
    <color name="st_status_offline_ink">#7A2E0E</color>

    <color name="st_status_nodevice">#E5484D</color>
