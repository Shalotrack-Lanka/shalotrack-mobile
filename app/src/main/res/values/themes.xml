<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.LetsTrackLanka" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/text_on_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/text_on_dark</item>

        <!-- Status & Navigation Bar Branding -->
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
    </style>

    <style name="Theme.LetsTrackLanka" parent="Base.Theme.LetsTrackLanka" />

    <!-- Modern Android Splash Screen Theme -->
    <style name="Theme.ShaloTrack.Starting" parent="Theme.SplashScreen">
        <!-- Solid background color -->
        <item name="windowSplashScreenBackground">#081427</item>

        <!-- Animated Vector Drawable -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_shalotrack_splash</item>

        <!-- Total animation time (ms) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>

        <!-- Fixed: Set to your actual main app theme -->
        <item name="postSplashScreenTheme">@style/Theme.LetsTrackLanka</item>
    </style>
</resources>