<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 to 11 (and the "full backup" path on 12+): back up NOTHING.
     The app keeps only per-customer state on the phone (customer id, selected vehicle, alert toggles) and
     Firebase's sign-in. Restoring those onto another phone would carry one customer's session state onto
     a device they may not own. Everything real lives on the server and comes back after signing in. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
