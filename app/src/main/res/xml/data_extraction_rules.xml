<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup AND no device-to-device transfer.
     android:allowBackup="false" alone does NOT stop the phone-to-phone transfer on Android 12+, so the
     same exclusions are listed for both. See backup_rules.xml for why nothing is backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
